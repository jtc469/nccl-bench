SBATCH_ARGS=(
    --partition=PPAC_MI300A_SPX
    --gres=gpu:2
)

MODULES=(
    "rocm/7.2.4"
)

OUTPUT_ARGS=(--output_format csv)

# SPX contains multiple real GPUs
# CPX splits 4 gpus into partitions -> 6 virtual GPUs

# Benchmark source for build.sh (rccl-tests has csv output built in)
TESTS_REPO=https://github.com/ROCm/rccl-tests.git
TESTS_BRANCH=
